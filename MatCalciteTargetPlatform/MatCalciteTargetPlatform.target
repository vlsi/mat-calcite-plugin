<?xml version="1.0" encoding="UTF-8" standalone="no"?>
<?pde version="3.8"?>
<target includeMode="feature" name="MAT Calcite: Eclipse 4.40 + MAT 1.17.0 + Calcite 1.42.0">
    <locations>
        <!-- Eclipse platform. MAT 1.17.0 itself builds against Eclipse 4.40, so this must not lag behind. -->
        <location includeAllPlatforms="false" includeConfigurePhase="false" includeMode="planner" includeSource="false" type="InstallableUnit">
            <repository location="https://download.eclipse.org/eclipse/updates/4.40/"/>
            <unit id="org.eclipse.equinox.executable.feature.group" version="0.0.0"/>
            <unit id="org.eclipse.equinox.p2.user.ui.feature.group" version="0.0.0"/>
            <unit id="org.eclipse.rcp.feature.group" version="0.0.0"/>
        </location>
        <!--
            MAT bundles. Resolved from the official MAT update site rather than an Eclipse simultaneous
            release, so the MAT API version always matches the MAT users actually run. The site is the one of
            the release (1.17.0), not mat/latest, so the build stays the same when a newer MAT ships; move it
            together with the bundle-version ranges in META-INF/MANIFEST.MF.

            Only the units this plugin needs are listed on purpose. Pulling org.eclipse.mat.feature.feature.group
            would drag in mat.chart/mat.chart.ui and therefore BIRT + Rhino, which are not required: nothing
            in the org.eclipse.mat.api -> org.eclipse.mat.report -> org.eclipse.mat.ui chain references them.

            org.eclipse.mat.api declares Bundle-RequiredExecutionEnvironment: JavaSE-21, so the execution
            environment of this target cannot go below JavaSE-21.
        -->
        <location includeAllPlatforms="false" includeConfigurePhase="false" includeMode="planner" includeSource="false" type="InstallableUnit">
            <repository location="https://download.eclipse.org/mat/1.17.0/update-site/"/>
            <unit id="org.eclipse.mat.api" version="0.0.0"/>
            <unit id="org.eclipse.mat.report" version="0.0.0"/>
            <unit id="org.eclipse.mat.ui" version="0.0.0"/>
            <unit id="org.eclipse.mat.parser" version="0.0.0"/>
            <unit id="org.eclipse.mat.hprof" version="0.0.0"/>
        </location>
        <!--
            Maven Central. These versions MUST stay in sync with MatCalcitePlugin/pom.xml; a mismatch is what
            caused the 1.36-vs-1.41 skew where the plugin compiled against one Calcite and ran against another.
            Calcite 1.42.0 requires Guava >= 33.4.8, avatica-core 1.28.0, jackson-core 2.18.6 (all pulled
            transitively via includeDependencyDepth="infinite").
        -->
        <location includeDependencyDepth="infinite" includeDependencyScopes="compile,provided,runtime" includeSource="true" label="Maven Central" missingManifest="generate" type="Maven">
            <dependencies>
                <dependency>
                    <groupId>net.minidev</groupId>
                    <artifactId>accessors-smart</artifactId>
                    <version>2.6.0</version>
                </dependency>
                <dependency>
                    <groupId>net.minidev</groupId>
                    <artifactId>json-smart</artifactId>
                    <version>2.6.0</version>
                </dependency>
                <dependency>
                    <groupId>org.apache.calcite</groupId>
                    <artifactId>calcite-core</artifactId>
                    <version>1.42.0</version>
                </dependency>
                <dependency>
                    <groupId>com.google.guava</groupId>
                    <artifactId>guava</artifactId>
                    <version>33.5.0-jre</version>
                </dependency>
                <dependency>
                    <groupId>com.google.code.findbugs</groupId>
                    <artifactId>jsr305</artifactId>
                    <version>3.0.2</version>
                </dependency>
                <!--
                    Provides the javax.transaction / javax.transaction.xa packages that commons-dbcp2 and
                    Calcite require. This must be declared here as well as in MatCalcitePlugin/pom.xml:
                    without it the resolver can pick up jakarta.transaction-api, which moved those packages
                    to jakarta.* and leaves commons-dbcp2 with an unsatisfiable Import-Package.
                -->
                <dependency>
                    <groupId>org.apache.geronimo.specs</groupId>
                    <artifactId>geronimo-jta_1.1_spec</artifactId>
                    <version>1.1.1</version>
                </dependency>
                <!--
                    Calcite 1.42.0 -> Avatica 1.28.0 pulls these in. They must be wrapped as OSGi bundles or
                    Avatica fails at runtime with NoClassDefFoundError: org/apache/hc/core5/util/Timeout.
                -->
                <dependency>
                    <groupId>org.apache.httpcomponents.client5</groupId>
                    <artifactId>httpclient5</artifactId>
                    <version>5.5</version>
                </dependency>
                <dependency>
                    <groupId>org.apache.httpcomponents.core5</groupId>
                    <artifactId>httpcore5</artifactId>
                    <version>5.3.5</version>
                </dependency>
                <!--
                    Calcite 1.42.0 depends on org.jooq:joou-java-6 at runtime scope. It is not pulled into
                    the target automatically; without it the plugin fails with
                    NoClassDefFoundError: org/joou/UInteger when Calcite builds its connection config.
                -->
                <dependency>
                    <groupId>org.jooq</groupId>
                    <artifactId>joou-java-6</artifactId>
                    <version>0.9.5</version>
                </dependency>
            </dependencies>
            <instructions><![CDATA[
        -reproducible: true
        -noextraheaders: true
        Bundle-Name:           Bundle derived from maven artifact ${mvnGroupId}:${mvnArtifactId}:${mvnVersion}
        version:               ${version_cleanup;${mvnVersion}}
        Bundle-SymbolicName:   wrapped.${mvnGroupId}.${mvnArtifactId}
        Bundle-Version:        ${version}
        Import-Package:        *;resolution:=optional
        Export-Package:        *;version="${version}";-noimport:=true
        DynamicImport-Package: *
        ]]></instructions>
        </location>
    </locations>
</target>
